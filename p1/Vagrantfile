Vagrant.configure("2") do |config|
	config.vm.box = "generic/centos8"

	config.ssh.insert_key = false
	
	if Vagrant.has_plugin?("vagrant-vbguest")
		config.vbguest.auto_update = false
	end
   
	config.vm.define "smickaelS" do |control|
	  control.vm.hostname = "smickaelS"
	  control.vm.network "private_network", ip: "192.168.56.110"
	  control.vm.synced_folder ".", "/vagrant", disabled: false
	  control.vm.provider "virtualbox" do |v|
		  v.name = "smickaelS"
			   v.gui = false
			   v.memory = "1024"
			   v.cpus = 1
		  end
	  control.vm.provision "shell", path: "scripts/install_server.sh"
	  end
	  
	config.vm.define "smickaelSW" do |agent|
	  agent.vm.hostname = "smickaelSW"
	  agent.vm.network "private_network", ip: "192.168.56.111"
	  agent.vm.synced_folder ".", "/vagrant", disabled: false
	  agent.vm.provider "virtualbox" do |v|
		  v.name = "smickaelSW"
		  v.gui = false
			   v.memory = "1024"
			   v.cpus = 1
		  end
	  agent.vm.provision "shell", path: "scripts/install_worker.sh"
	  end  
  end

